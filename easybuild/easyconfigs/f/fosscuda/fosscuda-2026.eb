easyblock = "Toolchain"

name = 'fosscuda'
version = '2026'

homepage = '(none)'
description = """GNU Compiler Collection (GCC) based compiler toolchain,
 alongside Open MPI, FlexiBLAS, ScaLAPACK, FFTW, and Cuda"""

toolchain = SYSTEM

local_gccver = '15.3.0'

# toolchain used to build fosscuda dependencies
local_comp_mpi_tc = ('gompi', version)

dependencies = [
    ('GCC', local_gccver),
    ('OpenMPI', '5.0.10', '', ('GCC', local_gccver)),
    ('FlexiBLAS', '3.5.0', '', ('GCC', local_gccver)),
    ('FFTW', '3.3.11', '', ('GCC', local_gccver)),
    ('FFTW.MPI', '3.3.11', '', local_comp_mpi_tc),
    ('ScaLAPACK', '2.2.2', '-fb', local_comp_mpi_tc),
    ('CUDA', '13.3', '', local_comp_mpi_tc),
]

moduleclass = 'toolchain'
