easyblock = 'MakeCp'

name = "FASTA"
version = "36.3.8i"
versiontag = 'v36.3.8i_14-Nov-2020'

homepage = 'http://fasta.bioch.virginia.edu'
description = """The FASTA programs find regions of local or global (new) similarity between 
protein or DNA sequences, either by searching Protein or DNA databases, or by identifying 
local duplications within a sequence."""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

source_urls = [f'https://github.com/wrpearson/fasta36/releases/download/{versiontag}']
sources = ['%(namelower)s-%(version)s-linux64.tar.gz']
checksums = ['a91dc8188ebd42867a7bd5ae15ff1811f10fc90bc3ad987335b227d541aad000']

buildopts = '-C ./src -f ../make/Makefile.linux64 all'

files_to_copy = ["bin", "conf", "data", "doc", "FASTA_LIST", "misc", "README", "seq", "sql", "test"]

local_fasta_binaries = [
    'fasta', 'fastf', 'fastm', 'fasts', 'fastx', 'fasty', 'ggsearch', 'glsearch', 
    'lalign', 'ssearch', 'tfastf', 'tfastm', 'tfasts', 'tfastx', 'tfasty',
]

sanity_check_paths = {
    'files': ["FASTA_LIST", "README"] +
             ['bin/map_db'] +
             ['bin/%s%%(version_major)s' % x for x in local_fasta_binaries],
    'dirs': ["conf", "data", "doc", "misc", "seq", "sql", "test"],
}

moduleclass = 'bio'
