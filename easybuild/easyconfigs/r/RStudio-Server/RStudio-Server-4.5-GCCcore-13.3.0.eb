easyblock = 'CMakeNinja'

name = 'RStudio-Server'
version = '4.5'

homepage = 'https://www.rstudio.com/'
description = """RStudio Server enables you to provide a browser
based interface to a version of R running on a remote Linux
server, bringing the power and productivity of the
RStudio IDE to server-based deployments of R."""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

source_urls = ['https://github.com/rstudio/rstudio/archive/']
sources = ['v2025.09.2+418.tar.gz']
patches = ['rstudio-1.2.1335.patch']

checksums = [
    {'v2025.09.2+418.tar.gz': '7e64e65bd3457855e981698dfb61f84e23de0d8bfcb2b1ffc28a38b5b964a769'},
    {'rstudio-1.2.1335.patch': 'ce2cf5d344a5d254aacfff628ce1eeae6968730a81d01319a823ad828a1a3be6'},
]

builddependencies = [
    ('gcccoreflexiblas', '2024a'),
    ('Boost', '1.87.0', '-core'),
    ('ant', '1.10.14'),
    ('SOCI', '4.0.3'),
    ('CMake', '3.31.0'),
    ('nodejs', '20.16.0'),
    ('yaml-cpp', '0.8.0'),
    ('Java', '17.0.6'),
]

dependencies = [
    ('R', '%(version)s.0', '', ('gcccoreflexiblas', '2023a')),
]

separate_build_dir = False

preconfigopts = " && ".join([
    "sed -i 's/^add_subdirectory(pam)$/# add_subdirectory(pam)/' src/cpp/server/CMakeLists.txt",
    "unset JAVA_TOOLS_OPTIONS",
    "export RSTUDIO_TOOLS_ROOT='%(builddir)s'", # otherwise sudo
    "cd %(builddir)s/rstudio-*/dependencies/common",
    "./install-cef",
    "./install-dictionaries",
    "./install-npm-dependencies",
    "./install-mathjax",
    "./install-pandoc",
    "./install-panmirror",
    "./install-packages",
    "./install-copilot-language-server",
    "./install-gwt",
    "cd %(builddir)s/rstudio-*/",
    "", # To append &&
])

configopts = " ".join([
    "-DRSTUDIO_TOOLS_ROOT='%(builddir)s'",
    "-DRSTUDIO_TARGET=Server",
    "-DRSTUDIO_BOOST_SIGNALS_VERSION=2",
    "-DSOCI_CORE_LIB=$EBROOTSOCI/lib/libsoci_core.so",
    "-DSOCI_POSTGRESQL_LIB=$EBROOTSOCI/lib/libsoci_postgresql.so",
    "-DSOCI_SQLITE_LIB=$EBROOTSOCI/lib/libsoci_sqlite3.so",
    "-DRSTUDIO_BOOST_REQUESTED_VERSION=$EBVERSIONBOOST",
    "-DRSTUDIO_USE_SYSTEM_BOOST=ON",
    "-DRSTUDIO_USE_SYSTEM_SOCI=ON",
    "-DQUARTO_ENABLED=OFF",
    "-DRSTUDIO_USE_SYSTEM_YAML_CPP=ON",
    "-DRSTUDIO_USE_PAM=OFF",
])

postinstallcmds = ["R_HOME=%(installdir)s/lib64/R PATH=$R_HOME/bin:$PATH R_DOC_DIR=%(installdir)s/lib64/R/doc R_INCLUDE_DIR=%(installdir)s/lib64/R/include R_SHARE_DIR=%(installdir)s/lib64/R/share /cvmfs/soft.computecanada.ca/easybuild/easybuild-computecanada-config/generate_cvmfs_filebundle.py --executable %(installdir)s/bin/rsession --args '--standalone=1 --program-mode=server --log-stderr=1 --session-timeout-minutes=0 --user-identity=$USER --www-port=8888' --follow-fork"]
# R has a dep on Java 17 which is incompatible at build time, so explicitly use 11 here...
#prebuildopts = "module load java/11.0.22 && "

sanity_check_paths = {
    'files': ["bin/rstudio-server", "bin/rsession", "bin/rserver", "bin/rpostback"],
    'dirs': ["R", "resources", "www", "www-symbolmaps"],
}

sanity_check_commands = [
    # This command requires environment variables R_HOME and R_DOC_DIR
    "R_HOME=$EBROOTR/lib64/R R_DOC_DIR=$R_HOME/doc rsession --verify-installation=1",

    # This command requires a db conf (this may also be needed for live use)
    # and need the current user, otherwise defaults to root
    ' && '.join([
        'MYTMP=$(mktemp -d)',
        'echo -e "provider=sqlite\ndirectory=$MYTMP/db" >> $MYTMP/db.conf',
        'rserver --verify-installation=1 --database-config-file=$MYTMP/db.conf --server-data-dir=$MYTMP/sdd --server-user=$USER',
    ])
]

# do not store user state in home directories, but keep backward compat
# for users starting an interactive job with rstudio
modluafooter = """
if os.getenv('SLURM_TMPDIR') then
    setenv('RSTUDIO_DATA_HOME', pathJoin(os.getenv('SLURM_TMPDIR'), '.rstudio/{version}'))
else
    setenv('RSTUDIO_DATA_HOME', pathJoin(os.getenv('HOME'), '.rstudio/{version}'))
end

-- Warn if the user's R library paths do not contain libraries for the R version
-- required by this RStudio-Server module (R {version}.x).
-- Strategy: if any path already matches the required version, skip the warning.
-- Only warn when mismatched library paths are found and none match.
local rstudio_r_version = "{version}"

local function r_ver_from_path(path)
    -- Extract a 'x.y' version component from a filesystem path
    for part in path:gmatch("[^/]+") do
        if part:match("^%d+%.%d+$") then return part end
    end
    return nil
end

local function scan_paths(paths_str, required)
    -- Scan colon-separated paths; return (true, nil) on match, (false, ver) on mismatch
    if not paths_str or paths_str == "" then return false, nil end
    local mismatch = nil
    for p in paths_str:gmatch("[^:]+") do
        local ver = r_ver_from_path(p)
        if ver == required then return true, nil end
        if ver then mismatch = ver end
    end
    return false, mismatch
end

local found_match = false
local mismatch_ver = nil

for _, envvar in ipairs({{"R_LIBS", "R_LIBS_USER"}}) do
    if not found_match then
        local val = os.getenv(envvar)
        local m, mis = scan_paths(val, rstudio_r_version)
        if m then found_match = true
        elseif mis then mismatch_ver = mis end
    end
end

-- Also check the default ~/R/<platform>-library/<x.y>/ directories
if not found_match and (os.getenv("R_LIBS_USER") or "") == "" then
    local home = os.getenv("HOME") or ""
    local quoted_home = "'" .. home:gsub("'", [['"'"']]) .. "'"
    local listing = capture("ls -d " .. quoted_home .. "/R/*-library/*/ 2>/dev/null")
    for line in listing:gmatch("[^\\n]+") do
        local ver = line:match("/(%d+%.%d+)/?$")
        if ver == rstudio_r_version then
            found_match = true
            break
        elseif ver then
            mismatch_ver = ver
        end
    end
end

if not found_match and mismatch_ver then
    LmodWarning([[This version of RStudio-Server requires R {version}.x, but your R library ]] ..
        [[path(s) contain packages installed for R ]] .. mismatch_ver .. [[.x. ]] ..
        [[Your installed R packages may not work correctly. Consider installing packages ]] ..
        [[for R {version}.x or loading a version of RStudio-Server matching your R libraries.]])
end
""".format(version=version)
