# This easyconfig was created by the BEAR Software team at the University of Birmingham.
easyblock = 'CMakeMake'
name = 'yaml-cpp'
version = '0.9.0'

homepage = "https://github.com/jbeder/yaml-cpp"
description = """yaml-cpp is a YAML parser and emitter in C++ matching the YAML 1.2 spec"""

toolchain = {'name': 'GCCcore', 'version': '15.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/jbeder/%(name)s/archive/']
sources = ['%(name)s-%(version)s.tar.gz']
checksums = ['25cb043240f828a8c51beb830569634bc7ac603978e0f69d6b63558dadefd49a']

builddependencies = [
      ('CMake', '4.4.2')
]

sanity_check_paths = {
    'files': ['lib/libyaml-cpp.a', 'include/yaml-cpp/yaml.h'],
    'dirs': ['lib', 'include'],
}

moduleclass = 'tools'
