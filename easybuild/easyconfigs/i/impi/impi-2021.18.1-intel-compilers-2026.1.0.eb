name = 'impi'
version = '2021.18.1'

homepage = 'https://software.intel.com/content/www/us/en/develop/tools/mpi-library.html'
description = "Intel MPI Library, compatible with MPICH ABI"

toolchain = {'name': 'intel-compilers', 'version': '2026.1.0'}

# see https://software.intel.com/content/www/us/en/develop/articles/oneapi-standalone-components.html
source_urls = [
    'https://registrationcenter-download.intel.com/akdlm/IRC_NAS/6fcf9602-c77b-4240-b48f-b867409578c7/',
]
sources = ['intel-mpi-%(version)s.10_offline.sh']
checksums = ['b1c6a701a618c6e1ff370a3e21b356f975ca97bfa9bfb8a486df09a78351af41']

dependencies = [('UCX', '1.22.0')]

# rebuild Fortran 2008 bindings to fix compilation failures when using CLASS(*) arguments,
# see https://community.intel.com/t5/Intel-MPI-Library/MPI-f08-with-polymorphic-argument-CLASS/m-p/1590421
rebuild_f08_bindings = True

set_mpi_wrappers_compiler = True

moduleclass = 'mpi'
