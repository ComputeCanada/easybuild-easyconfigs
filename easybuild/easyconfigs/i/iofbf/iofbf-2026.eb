easyblock = "Toolchain"

name = 'iofbf'
version = '2026'

homepage = 'https://software.intel.com/en-us/intel-cluster-toolkit-compiler/'
description = """Intel Compilers based compiler toolchain,
 alongside Open MPI, FlexiBLAS, FFTW and ScaLAPACK."""

toolchain = SYSTEM

local_compver = '2026.1.0'
local_comp_mpi_tc = ('iompi', version)

dependencies = [
    ('intel-compilers', local_compver),
    ('OpenMPI', '5.0.10', '', ('intel-compilers', local_compver)),
    ('FlexiBLAS', '3.5.0', '', ('intel-compilers', local_compver)),
    ('FFTW', '3.3.11', '', ('intel-compilers', local_compver)),
    ('FFTW.MPI', '3.3.11', '', local_comp_mpi_tc),
    ('ScaLAPACK', '2.2.2', '-fb', local_comp_mpi_tc),
]

moduleclass = 'toolchain'
