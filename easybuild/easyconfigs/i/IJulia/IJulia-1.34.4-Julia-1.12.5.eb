    ('MbedTLS_jll', '2.28.1010+0', {
        'source_urls': ['https://github.com/JuliaBinaryWrappers/MbedTLS_jll.jl/archive/'],
        'sources': [{'filename': 'MbedTLS-v%(version)s.tar.gz'}],
        'checksums': ['39972b87afe0d7f191a9746bbf8102bbd45d2e904edd0d914d553c532e0c9049'],
