# This is an easyconfig file for EasyBuild, see https://easybuilders.github.io/easybuild
easyblock = "Toolchain"

name = 'ifbf'
version = '2026'

homepage = '(none)'
description = """Intel based compiler toolchain, including
 FlexiBLAS (BLAS and LAPACK support) and (serial) FFTW."""

toolchain = SYSTEM

local_compver = '2026.1.0'

dependencies = [
    ('intel-compilers', local_compver),
    ('FlexiBLAS', '3.5.0', '', ('intel-compilers', local_compver)),
    ('FFTW', '3.3.11', '', ('intel-compilers', local_compver)),
]

moduleclass = 'toolchain'
