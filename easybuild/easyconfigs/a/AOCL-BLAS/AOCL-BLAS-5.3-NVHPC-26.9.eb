easyblock = 'ConfigureMake'

name = 'AOCL-BLAS'
version = '5.3'

homepage = 'https://github.com/amd/blis'
description = """AOCL-BLAS is AMD's optimized version of
                 BLAS targeted for AMD EPYC and Ryzen CPUs."""

toolchain = {'name': 'NVHPC', 'version': '26.9'}
toolchainopts = {'optarch': False}

source_urls = ['https://github.com/amd/blis/archive/']
sources = ['AOCL-%(version)s.tar.gz']
patches = [
    'AOCL-BLAS-5.0_family-x86_64_v3.patch',
]
checksums = [
    {'AOCL-5.3.tar.gz': 'a5af70779892b54196e63e5b1f2a3915f4829eff1adff664895f6286568098bf'},
    {'AOCL-BLAS-5.0_family-x86_64_v3.patch': 'f00b3d8cc238d84fd65b4f6988f6346e59811917ac462515c695ec8421a78e06'},
]

builddependencies = [
    ('Python', '3.14.7'),
    ('Perl', '5.44.0'),
]

# use gcc + its CFLAGS because nvhpc can't be used directly, but nvc for linking to use libnvomp
preconfigopts = 'unset CFLAGS && cp config/amdzen/bli_family_amdzen.h config/x86_64_v3 && '
preconfigopts += "sed -i 's/LINKER.*/LINKER := nvc/' common.mk &&"
local_configopts = '--complex-return=intel --enable-cblas --enable-threading=openmp --enable-shared CC=gcc x86_64_v3'
configopts = ['-i64 -b64 ' + local_configopts, local_configopts]
prebuildopts = "unset CFLAGS && declare -A ARCH_MAP=( [avx2]='3' [avx512]='4' ) &&"
local_buildopts = 'CC="gcc -O2 -ftree-vectorize -fno-math-errno -march=x86-64-v${ARCH_MAP[$RSNT_ARCH]}" ENABLE_VERBOSE=yes'
buildopts = ['LIBBLIS=libblis-mt64 MK_INCL_DIR_INST=%(installdir)s/include/blis64 ' + local_buildopts, local_buildopts]
preinstallopts = prebuildopts
installopts = buildopts

runtest = 'check'

sanity_check_paths = {
    'files': ['include/blis/cblas.h', 'include/blis/blis.h',
              'lib/libblis-mt64.a', 'lib/libblis-mt64.%s' % SHLIB_EXT,
              'lib/libblis-mt.a', 'lib/libblis-mt.%s' % SHLIB_EXT],
    'dirs': [],
}

modextrapaths = {'CPATH': 'include/blis'}

moduleclass = 'numlib'
