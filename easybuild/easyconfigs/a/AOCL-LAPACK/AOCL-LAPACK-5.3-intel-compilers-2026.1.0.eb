easyblock = 'Bundle'

name = 'AOCL-LAPACK'
version = '5.3'

homepage = 'https://github.com/amd/libflame'
description = """AOCL-LAPACK is AMD's optimized version of
                 LAPACK targeted for AMD EPYC and Ryzen CPUs."""

toolchain = {'name': 'intel-compilers', 'version': '2026.1.0'}
toolchainopts = {'lowopt': True, 'vectorize': True}

builddependencies = [
    ('CMake', '4.4.2'),
    #('Python', '3.14.7'),
    ('Perl', '5.44.0'),
]

dependencies = [
    ('AOCL-BLAS', '%(version)s'),
]

default_component_specs = {'sources': [{'download_filename': '%(version)s.tar.gz',
                                        'filename': SOURCELOWER_TAR_GZ}]}
sanity_check_all_components = True

local_lapack_component = [name, version, {
    'source_urls': ['https://github.com/amd/libflame/archive/refs/tags'],
    'checksums': ['ecb74c879b4d6bb33e159300304a9b48206d2c2b546dceb7d097b339eb127b9c'],
    'start_dir': 'libflame-%(version)s',
    'preconfigopts': 'sed -i "s/-pie//" ../libflame-5.3/cmake/CompilerFlags.cmake && ',
    'configopts': ('-DCMAKE_EXT_BLAS_LIBRARY_DEPENDENCY_PATH=$EBROOTAOCLMINBLAS '
                   '-DENABLE_F2C_DOTC=ON -DENABLE_VOID_RETURN_COMPLEX_FUNCTION=ON '
                   '-DCMAKE_C_FLAGS_RELEASE="$CFLAGS -mtune=generic -DNDEBUG"'),
    'runtest': True,
    'run_lapack_tests': True,
    'max_failing_lapack_tests_num_errors': 50,
}]

local_lapack_ilp64_component = local_lapack_component[:]
local_lapack_ilp64_component[2] = dict(local_lapack_component[2])
local_lapack_ilp64_component[2]['patches'] = [
    'AOCL-LAPACK-5.1_libname-suffix.patch',
    'AOCL-LAPACK-5.3_support-shlib-netlib-tests.patch',
]
local_lapack_ilp64_component[2]['checksums'].extend([
    {'AOCL-LAPACK-5.1_libname-suffix.patch':
     '88fb092df0f4aa553d94036dc0a4609df0f905a0c31a3fd4daeb4451bf44ff7f'},
    {'AOCL-LAPACK-5.3_support-shlib-netlib-tests.patch':
     'ee4dd7b5c6f12b2e58e61aae13c7fb7d4ad5903d98fcead3777a11de817a333a'}
])
local_lapack_ilp64_component[2]['configopts'] += (' -DENABLE_ILP64=ON -DLIBNAME_SUFFIX=64 '
    '-DAOCL_ROOT=$EBROOTAOCLMINBLAS -DAOCL_BLAS_INCLUDE_DIR=$EBROOTAOCLMINBLAS/include/blis64 '
    '-DAOCL_BLAS_LIB=libblis-mt64.so')

components = [
    ('AOCL-Utils', version, {
        'easyblock': 'CMakeMake',
        'source_urls': ['https://github.com/amd/aocl-utils/archive/refs/tags'],
        'checksums': ['0e29afbbda3b81528380d2dbf7dae1ed6825d8c69e0abfcce53cc6cf90430e69'],
        'start_dir': '%(namelower)s-%(version)s',
        'sanity_check_paths': {
            'files': ['lib/libaoclutils.%s' % SHLIB_EXT, 'include/Capi/au/cpuid/cpuid.h'],
            'dirs': [],
        },
    }),
    local_lapack_ilp64_component,
    local_lapack_component,
]

sanity_check_paths = {
    'dirs': ['include', 'lib'],
    'files': ['include/lapack.h', 'include/FLAME.h',
              'lib/libflame64.%s' % SHLIB_EXT,
              'lib/libflame.%s' % SHLIB_EXT],
}

moduleclass = 'numlib'
