name = 'AOCL-LAPACK'
easyblock = 'Bundle'
version = '5.3'
altroot = 'AOCL-LAPACK'

homepage = 'https://github.com/amd/blis'
description = """AOCL-LAPACK is AMD's optimized version of
                 LAPACK targeted for AMD EPYC and Ryzen CPUs."""

toolchain = {'name': 'GCC', 'version': '15.3.0'}

builddependencies = [
    ('AOCL-LAPACK', version, '', ('GCCcore', '15.3.0')),
]

moduleclass = 'lib'
