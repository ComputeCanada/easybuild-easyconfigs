#!/bin/sh
export EBPYTHONPREFIXES=%EBPYTHONPREFIXES
export DATA_DIR=${OPENWEBUI_DATA_DIR:-$HOME/openwebui}
mkdir -p $DATA_DIR
export OFFLINE_MODE=${OPENWEBUI_OFFLINE_MODE:-true}
export HF_HUB_OFFLINE=${OPENWEBUI_HF_HUB_OFFLINE:-1}
export RAG_EMBEDDING_MODEL_AUTO_UPDATE=${OPENWEBUI_RAG_EMBEDDING_MODEL_AUTO_UPDATE:-false}
export RAG_RERANKING_MODEL_AUTO_UPDATE=${OPENWEBUI_RAG_RERANKING_MODEL_AUTO_UPDATE:-false}
export WHISPER_MODEL_AUTO_UPDATE=${OPENWEBUI_WHISPER_MODEL_AUTO_UPDATE:-false}
exec %INSTALLDIR/bin/uvicorn open_webui.main:app ${1+"$@"}

