easyblock = 'Binary'

name = 'Open-WebUI'
version = '0.7.2'

homepage = 'https://docs.openwebui.com/'

description = """Open WebUI is an extensible, feature-rich, and user-friendly self-hosted AI platform
designed to operate entirely offline. It is built around universal standards, supporting Ollama and 
OpenAI-compatible Protocols (specifically Chat Completions). This protocol-first approach makes it a 
powerful, provider-agnostic AI deployment solution for both local and cloud-based models."""

toolchain = {'name': 'GCCcore', 'version': '12.3.0'}

# this is a bundle of Python packages
exts_defaultclass = 'PythonPackage'

builddependencies = [
  ('Arrow', '22.0.0'),
  ('Python', '3.11'),
  ('GCC', '12.3'),
  ('OpenCV', '4.12.0', '', ('gccflexiblas', '2023a'))
  ('SciPy-Stack', '2025a'),
]

preinstallopts = ['python -m venv %(installdir)s && source %(installdir)s/bin/activate && ']
install_cmd = 'pip install'
installopts = '--no-index --no-deps -r requirements-%(version)s.txt'
sources = ['requirements-%(version)s.txt']

postinstallcmds = [
  "echo '#!/bin/sh' >> %(installdir)s/bin/open-webui-serve",
  "echo export EBPYTHONPREFIXES=$EBROOTARROW:$EBROOTOPENCV:$EBROOTSCIPYMINSTACK:%(installdir)s >> %(installdir)s/bin/open-webui-serve",
  'echo exec %(installdir)s/bin/open-webui serve \${1+\\"\$@\\"} >> %(installdir)s/bin/open-webui-serve',
  "chmod +x %(installdir)s/bin/open-webui-serve"
]

sanity_check_paths = {
    'files': ['bin/open-webui'],
    'dirs': ['lib'],
}
moduleclass = 'lib'
modluafooter = """
depends_on("python")
"""

