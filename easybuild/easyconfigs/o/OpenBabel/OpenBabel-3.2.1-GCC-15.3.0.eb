name = 'OpenBabel'
version = '3.2.1'

homepage = 'https://openbabel.org'
description = """Open Babel is a chemical toolbox designed to speak the many
 languages of chemical data. It's an open, collaborative project allowing anyone
 to search, convert, analyze, or store data from molecular modeling, chemistry,
 solid-state materials, biochemistry, or related areas."""

toolchain = {'name': 'GCC', 'version': '15.3.0'}
toolchainopts = {'pic': True}

source_urls = [GITHUB_LOWER_SOURCE]
sources = ['%%(namelower)s-%s.tar.gz' % version.replace('.', '-')]
patches = []
checksums = [
    {'openbabel-3-2-1.tar.gz': 'e140c25480fe1678d00b9a52462368fa4e7805fba67b12ee496784437f3e239e'},
]

builddependencies = [
    ('CMake', '3.27.7'),
    ('SWIG', '4.4.1'),
    ('Boost', '1.92.0'),
    ('Eigen', '3.5.0'),
    ('RapidJSON', '1.1.0-20250205'),
    ('maeparser', '1.3.3'),
    ('CoordgenLibs', '3.0.2'),
    ('python-build-bundle', '2026b'),
]

dependencies = [
]

with_python_bindings = False

configopts = ' '.join([
    "-DBoost_INCLUDE_DIR=$EBROOTBOOST/include",
    "-DBoost_LIBRARY_DIR_RELEASE=$EBROOTBOOST/lib",
    "-DENABLE_OPENMP=ON",
])

multi_deps = {'Python': ['3.14', '3.15']}
multi_deps_extensions_only = True
# do not wipe installation in prepare_step. This ensure python3.* and installation directory content is preserved
keeppreviousinstall = True

exts_defaultclass = 'PythonPackage'
exts_list = [
    ('openbabel', '3.2.1', {
        'preinstallopts': 'PKG_CONFIG_PATH="%(installdir)s/lib/pkgconfig:$PKG_CONFIG_PATH" ',
        'sources': [{'filename': '%(name)s-%(version)s.tar.gz', 'download_filename': '%(name)s-%(version)s.tar.gz'}],
        'source_urls': ['https://pypi.python.org/packages/source/o/openbabel/'],
        'checksums': [
            {'openbabel-3.2.1.tar.gz': '3afad3decd3b4343e09af3d98472b72f84cbf9a0fa25c2e4eb102abc334548c3'},
        ],
        'use_pip': True,
    }),
]
exts_filter = ("python -c 'import %(ext_name)s'", '')

postinstallcmds = [
    "/cvmfs/soft.computecanada.ca/easybuild/bin/setrpaths --path %(installdir)s/lib/openbabel --any_interpreter --add_path %(installdir)s/lib",
]

moduleclass = 'chem'
