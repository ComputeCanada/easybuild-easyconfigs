name = 'OpenBLAS'
easyblock = 'Bundle'
version = '0.3.34'
altroot = 'OpenBLAS'

homepage = 'http://www.openblas.net/'
description = "OpenBLAS is an optimized BLAS library based on GotoBLAS2 1.13 BSD version."

toolchain = {'name': 'GCC', 'version': '15.3.0'}

builddependencies = [
    ('OpenBLAS', version, '', ('GCCcore', '15.3.0')),
]

moduleclass = 'lib'
