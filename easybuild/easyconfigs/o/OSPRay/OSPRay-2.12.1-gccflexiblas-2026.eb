easyblock = 'CMakeMake'

name = 'OSPray'
version = '2.12.1'

homepage = 'https://github.com/ospray/ospray'
description = """Intel OSPRay is an open source, scalable, and portable ray tracing engine for high-performance, 
high-fidelity visualization on Intel Architecture CPUs. """

toolchain = {'name': 'gccflexiblas', 'version': '2026'}

source_urls = ['https://github.com/ospray/ospray/archive']
sources = ['v%(version)s.tar.gz']

builddependencies = [
    ('CMake', '4.4.2'),
    ('ispc', '1.32.0'),
    ('googletest', '1.17.0'),
    ('googlebenchmark', '1.10.0'),
]
dependencies = [
    ('GLFW', '3.5.1'),
    ('Embree', '4.4.1'),
    ('Boost', '1.92.0'),
    ('rkcommon', '1.11.0'),
    ('OpenVDB', '14.0.0'),
    ('OpenEXR', '3.4.12'),
    ('Blosc', '1.21.6'),
    ('OpenVKL', '1.3.2'),
    ('OpenImageDenoise', '2.5.1'),
    ('tbb', '2022.3.0'),
]

configopts = '-DOSPRAY_MODULE_DENOISER=ON '
separate_build_dir = True

sanity_check_paths = {
    'files': ['lib64/libospray.so', 'bin/ospBenchmark', 'lib64/libospray_module_denoiser.so'],
    'dirs': ['include/ospray'],
}
moduleclass = 'tools'
