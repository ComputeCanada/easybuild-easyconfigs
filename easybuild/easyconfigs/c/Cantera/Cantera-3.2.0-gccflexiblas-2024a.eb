easyblock = 'SCons'

name = 'Cantera'
version = '3.2.0'

homepage = 'https://github.com/Cantera/cantera'
description = """Chemical kinetics, thermodynamics, and transport tool suite"""

toolchain = {'name': 'gccflexiblas', 'version': '2024a'}

# Must use a recursive clone to get mandatory example data directory
sources = [{
    'filename': 'cantera-%(version)s.tar.xz',
    'git_config': {
        'url': 'https://github.com/Cantera',
        'repo_name': 'cantera',
        'tag': 'v%(version)s',
        'recursive': True,
        'keep_git_dir': False,
    },
}]
checksums = ['84559f92c5d693b0337655a5533a0725ca0cb1fb95d96decae36e5d3b911e9ed']

multi_deps_load_default = False
multi_deps = {"Python": ["3.11", '3.12', '3.13']}

# Cantera is mostly used with Python and depends on Numpy.
builddependencies = [
    ('Boost', '1.87.0', '-core'),
    # ('SUNDIALS', '6.6.0'),
    ('Eigen', '3.4.0'),
    ('googletest', '1.14.0'),
    ('yaml-cpp', '0.7.0'),
    ('numpy', '2.1.1'),
    ('Cython', '3.0.11'),
    ('HDF5', '1.14.5'),
    # ('HighFive', '2.9.0'),
]

# No LTO...
# There is a bug under GCC 12 which prevents LTO. And, since our python modules
# uses different GCCcore, LTO cannot be used because version mismatch.
local_common_opts = " ".join([
    'env_vars=all',
    # 'CC="$CC"',
    # 'CXX="$CXX"',
    # 'FORTRAN=gfortran',
    'CXX="g++ -fcommon -fno-lto"',
    'no_debug_linker_flags="-fno-lto -fcommon"',
    'cc_flags="$CFLAGS"',
    'cxx_flags="$CXXFLAGS"',
    'blas_lapack_libs=flexiblas',
    'blas_lapack_dir=$EBROOTFLEXIBLAS/lib',
    'boost_inc_dir=$EBROOTBOOST/include',
    # 'sundials_include=$EBROOTSUNDIALS/include',
    # 'sundials_libdir=$EBROOTSUNDIALS/lib',
    'extra_inc_dirs=$EBROOTEIGEN/include',
    'python_cmd=$EBROOTPYTHON/bin/python',
])

prebuildopts = 'pip install --prefix=%(builddir)s ruamel.yaml jinja2 setuptools --ignore-installed && export PYTHONPATH=%(builddir)s/lib/python%(pyshortver)s/site-packages:$PYTHONPATH && '
buildopts = 'build ' + local_common_opts
# tests hang, so disable them for now
# runtest = 'test ' + local_common_opts
preinstallopts = ' && '.join([
    'pip install --prefix=%(installdir)s ruamel.yaml',
    'export PYTHONPATH=%(installdir)s/lib/python%(pyshortver)s/site-packages:%(builddir)s/lib/python%(pyshortver)s/site-packages:$PYTHONPATH',
    '',
])
installopts = ' ' + local_common_opts
prefix_arg = 'prefix='

modextrapaths = {"EBPYTHONPREFIXES": ""}

sanity_check_paths = {
    'files': [],
    'dirs': ['bin', 'include/cantera', 'lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ["module load scipy-stack && python -c 'import cantera'"]

moduleclass = 'chem'
