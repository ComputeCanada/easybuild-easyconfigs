name = 'code-server'
version = '4.141.1'

homepage = 'https://github.com/coder/code-server'
description = "Run VS Code on any machine anywhere and access it in the browser."

toolchain = {'name': 'system', 'version': 'system'}

source_urls = [
        'https://github.com/coder/%(name)s/releases/download/v%(version)s/',
]
sources = ['%(name)s-%(version)s-linux-%(mapped_arch)s.tar.gz']
patches = ['code-server-env-variables.patch']

postinstallcmds = [
    'mkdir -p %(installdir)s/extensions/foxundermoon.shell-format-7.0.1/bin; pushd %(installdir)s/extensions/foxundermoon.shell-format-7.0.1/bin; wget https://github.com/mvdan/sh/releases/download/v3.14.1/shfmt_v3.14.1_linux_amd64; chmod +x shfmt_v3.14.1_linux_amd64; popd',
    'chmod go+rX -R %(installdir)s/extensions',
    '/cvmfs/soft.computecanada.ca/easybuild/bin/setrpaths.sh --path %(installdir)s --add_origin ',
    'sed -i -e "s;#!/bin/sh;#!/cvmfs/soft.computecanada.ca/gentoo/2023/x86-64-v3/usr/bin/bash;g" %(installdir)s/bin/code-server',
    "/cvmfs/soft.computecanada.ca/easybuild/easybuild-computecanada-config/generate_cvmfs_filebundle.py --executable %(installdir)s/bin/code-server --args '--auth=none --disable-telemetry --socket=/tmp/test.socket'"
]
exts_defaultclass = 'VSCodeExtension'
exts_default_options = {
  'source_tmpl': '%(name)s-%(version)s.vsix'
}


exts_list = [
    ('nsight-vscode-edition', '2026.1.38526614', {
    	'source_urls': ['https://open-vsx.org/api/NVIDIA/nsight-vscode-edition/linux-x64/%(version)s/file'],
        'sources': ['NVIDIA.%(name)s-%(version)s@linux-x64.vsix'],
    }),
    ('ms-python.python', '2026.4.0', {
        'source_urls': ['https://open-vsx.org/api/ms-python/python/%(version)s/file'],
    }),
    ('ms-python.black-formatter', '2025.2.0', {
        'source_urls': ['https://open-vsx.org/api/ms-python/black-formatter/%(version)s/file'],
    }),
    ('ms-python.debugpy', '2026.6.0', {
        'source_urls': ['https://open-vsx.org/api/ms-python/debugpy/linux-x64/%(version)s/file'],
        'sources': ['%(name)s-%(version)s@linux-x64.vsix']
