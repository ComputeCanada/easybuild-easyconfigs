# #
# @Author: Ali Kerrache, University of Manitoba
# @Date: Feb 07, 2019.
# #

easyblock = 'CMakeMake'

name = 'colmap'
version = '3.12.6'

homepage = 'https://github.com/colmap/colmap'
description = "COLMAP is a general-purpose Structure-from-Motion (SfM) and Multi-View Stereo (MVS) pipeline with a graphical and command-line interface. It offers a wide range of features for reconstruction of ordered and unordered image collections. The software is licensed under the new BSD license."

toolchain = {'name': 'gofbc', 'version': '2023.2.415.126'}
toolchainopts = {'cstd': 'c++11', 'pic': True, 'openmp': True}

source_urls = ['https://github.com/%(name)s/%(name)s/archive']
sources = ['%(version)s.tar.gz']
checksums = ['f66d34be7a738fa753d1b71aec4fb7411d8c117beb58d1f2ba84ee2696c96410']

dependencies = [
    ('ceres-solver', '2.2.0'),
    ('Boost', '1.82.0'),
    ('Eigen', '3.4.0', '', True),
    ('METIS', '5.1.0', '-32idx'),
    ('SuiteSparse', '7.6.0', '-32idx'),
    ('CGAL', '5.5.2'),
    ('Qt5', '5.15.11'),
]
builddependencies = [
    ('CMake', '3.31.0'),
    ('googletest', '1.14.0'),
]

configopts = ""
configopts += "-DTESTS_ENABLED=ON "
configopts += "-DIPO_ENABLED=ON -DSIMD_ENABLED=ON -DCGAL_ENABLED=ON "

local_libraries = ['lib/libcolmap_%s.a' % x for x in ['exe', 'estimators', 'controllers', 'feature', 'feature_types', 'geometry', 'image', 'lsd', 'math', 'mvs', 'optim', 'poisson_recon', 'retrieval', 'scene', 'sensor', 'sfm', 'sift_gpu', 'ui', 'util', 'vlfeat']]
local_libraries += ['lib/libfaiss.a', 'lib/libPoseLib.a']
sanity_check_paths = {
    'files': ['bin/%(name)s'] + local_libraries,
    'dirs': ['bin', 'include', 'include/%(name)s', 'lib', 'share'],
}

moduleclass = 'vis'
