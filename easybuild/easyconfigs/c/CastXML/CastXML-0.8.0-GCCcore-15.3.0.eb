easyblock = 'CMakeMake'

name = 'CastXML'
version = '0.8.0'

homepage = 'https://github.com/CastXML/CastXML'
description = """CastXML is a C-family abstract syntax tree XML output tool."""

toolchain = {'name': 'GCCcore', 'version': '15.3.0'}

github_account = 'CastXML'
source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s.tar.gz']
checksums = ['68e91af54851ef341fae72299f7576892c3317f7b40d00590ed79d00dc30a16c']

builddependencies = [
    ('binutils', '2.46.1'),
    ('CMake', '4.4.2'),
    ('LLVM', '22.1.8'),
]

dependencies = [
    ('ncurses', '6.6'),
    ('zlib', '2.3.3'),
]

sanity_check_paths = {
    'files': ['bin/castxml'],
    'dirs': ['share/castxml'],
}

moduleclass = 'tools'
