name = 'Python'
version = '3.15.2'

homepage = 'https://python.org/'
description = """Python is a programming language that lets you work more quickly and integrate your systems
 more effectively."""

toolchain = {'name': 'GCCcore', 'version': '15.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://www.python.org/ftp/%(namelower)s/%(version)s/']
sources = [SOURCE_TGZ]
patches = [
    'Python-3.13.1_runshared-ld-preload.patch',
    'Python-3.14.2-custom-ctypes.patch',
    # 'Python-3.13.1_ssl-distrust-compromised-eMudhra-intermediate-CA-keys-CVE-2026-115557.patch',
]

# Like patches, but these will only be applied if EasyBuild is configured to filter $LD_LIBRARY_PATH
# In that scenario, ctypes needs to be patched since it heavily relies on $LD_LIBRARY_PATH to find libraries
#patch_ctypes_ld_library_path = 'Python-3.14.2-custom-ctypes.patch'

builddependencies = [
    ('UnZip', '6.0'),
    ('pkgconf', '2.5.1'),
]

dependencies = [
    ('binutils', '2.46.1'),
    ('bzip2', '1.0.8'),  # required for bz2 package in Python stdlib
    ('zlib', '2.3.2'),
    ('libreadline', '8.3'),
    ('ncurses', '6.6'),
    ('SQLite', '3.51.1'),
    ('XZ', '5.8.2'),
    ('libffi', '3.5.2'),
    ('OpenSSL', '3', '', SYSTEM),
    ('zstd', '1.5.7'),
]


# See https://discuss.python.org/t/out-of-range-error-when-building-python-3-14-7-with-gcc-16-2-0/108539
preconfigopts = "CFLAGS=${CFLAGS/-fno-math-errno/} PROFILE_TASK='-m test --pgo -i test_system_transitions'"
prebuildopts = preconfigopts

install_pip = True

exts_default_options = {
    'source_urls': [PYPI_SOURCE],
}

# Order and name (as-is) are important! Must match ones from the hooks
exts_list = [
    ('flit_core', '4.2.0'),
    ('wheel', '0.48.0'),
    ('setuptools', '84.2.1', {'patches': ['setuptools-fix_trove_classifiers_hassle.patch'], 'sources': ['setuptools-84.2.1.tar.gz']}),
    ('pip', '26.2.2'),
    ('packaging', '26.3'),
    ('vcs_versioning', '2.6.0'),
    ('setuptools_scm', '10.3.4'),
    ('pathspec', '1.1.1'),
    ('pluggy', '1.7.0'),
    ('trove_classifiers', '2026.9.21.13',  {'source_tmpl': 'trove_classifiers-2026.9.21.13-py3-none-any.whl'}),
    ('poetry-core', '2.5.0', {'modulename': 'poetry.core'}),
    ('tomlkit', '0.15.2'),
    ('hatchling', '1.33.0', {'source_tmpl': 'hatchling-1.33.0-py3-none-any.whl'}),
    ('hatch_vcs', '0.5.0'),
    ('platformdirs', '4.14.0', {'source_tmpl': 'platformdirs-4.14.0-py3-none-any.whl'}),
    ('filelock', '4.2.4'),
    ('distlib', '0.4.4'),
    ('typing_extensions', '4.16.0'),
    ('python-discovery', '1.6.7', {'source_tmpl': 'python_discovery-1.6.7-py3-none-any.whl'}),
    ('virtualenv', '21.15.1', {'source_tmpl': 'virtualenv-21.15.1-py3-none-any.whl'}),
]

modluafooter = """
family("%(namelower)s")
conflict("%(name)s")
"""

moduleclass = 'lang'
