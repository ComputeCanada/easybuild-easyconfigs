name = 'Python'
version = '3.14.2'

homepage = 'https://python.org/'
description = """Python is a programming language that lets you work more quickly and integrate your systems
 more effectively."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://www.python.org/ftp/%(namelower)s/%(version)s/']
sources = [SOURCE_TGZ]
patches = [
     'Python-3.13.1_runshared-ld-preload.patch',
     'Python-3.14.2_skip-inf-recursion-tests.patch',
     'Python-3.14.2-custom-ctypes.patch',
]

# Like patches, but these will only be applied if EasyBuild is configured to filter $LD_LIBRARY_PATH
# In that scenario, ctypes needs to be patched since it heavily relies on $LD_LIBRARY_PATH to find libraries
#patch_ctypes_ld_library_path = 'Python-3.14.2-custom-ctypes.patch'

builddependencies = [
    ('UnZip', '6.0'),
    ('pkgconf', '1.9.3'),
]

dependencies = [
    ('binutils', '2.40'),
    ('bzip2', '1.0.8'),  # required for bz2 package in Python stdlib
    ('zlib', '1.2.12'),
    ('libreadline', '8.2'),
    ('ncurses', '6.3'),
#    ('SQLite', '3.39.4'),
    ('XZ', '5.2.7'),
#    ('libffi', '3.3'),
    ('OpenSSL', '1.1', '', SYSTEM),
]

install_pip = True

exts_default_options = {
    'download_dep_fail': True,
    'sanity_pip_check': True,
    'source_urls': [PYPI_SOURCE],
    'use_pip': True,
}

# Order and name (as-is) are important! Must match ones from the hooks
exts_list = [
    ('flit_core', '3.12.0'),
    ('wheel', '0.46.3'),
    ('setuptools', '82.0.0', {'patches': ['setuptools-fix_trove_classifiers_hassle.patch'], 'sources': [SOURCELOWER_TAR_GZ]}),
    ('pip', '26.0.1'),
    ('packaging', '26.0'),
    ('setuptools_scm', '9.2.2'),
    ('pathspec', '0.12.1'),
    ('pluggy', '1.6.0'),
    ('trove_classifiers', '2026.1.14.14',  {'source_tmpl': 'trove_classifiers-2026.1.14.14-py3-none-any.whl'}),
    ('hatchling', '1.28.0'),
    ('hatch_vcs', '0.5.0'),
    ('platformdirs', '4.5.1'),
    ('filelock', '3.20.3'),
    ('distlib', '0.4.0'),
    ('typing_extensions', '4.15.0'),
    ('virtualenv', '20.36.1'),
]

modluafooter = """
family("%(namelower)s")
conflict("%(name)s")
"""

moduleclass = 'lang'
