easyblock = 'CMakeMake'

name = 'PROJ'
version = '9.9.0'

homepage = 'https://proj.org'
description = """Program proj is a standard Unix filter function which converts
geographic longitude and latitude coordinates into cartesian coordinates"""

toolchain = {'name': 'GCCcore', 'version': '15.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://download.osgeo.org/proj/']
sources = [SOURCELOWER_TAR_GZ]
checksums = ['791a0610547eeabb17006cfd49cdbd2034f3240f47ed5e88a1031811f4e2bcf3']

builddependencies = [
    ('CMake', '4.4.2'),
    ('Cython', '3.3.0'),
    ('numpy', '2.5.3'),
]

dependencies = [
]

multi_deps= {'Python': ['3.14']}
multi_deps_extensions_only = True

exts_defaultclass = 'PythonPackage'

exts_list = [
    ('pyproj', '3.8.0', {
        'buildopts': '#',
        'check_ldshared': False,
        'modulename': 'pyproj',
        'preconfigopts': '#',
        'runtest': False,
        'sanity_pip_check': True,
        'source_urls': ['https://pypi.python.org/packages/source/%(nameletter)s/%(name)s'],
        'use_pip': True,
        'use_pip_for_deps': True,
        'checksums': ['efa59725bba68bf97fa808b61302df32934acdceb6a5c92a8dd0e71dc266a876'],
    }),
]

exts_filter = ("python -c 'import %(ext_name)s'", '')

sanity_check_paths = {
    'files': ['bin/cct', 'bin/cs2cs', 'bin/geod', 'bin/gie', 'bin/proj', 'bin/projinfo',
              'lib/libproj.%s' % SHLIB_EXT],
    'dirs': ['include'],
}

sanity_check_commands = [
    "module load scipy-stack && python -c 'import pyproj;'",
]

modextrapaths = {'EBPYTHONPREFIXES': [''],}

moduleclass = 'lib'
