easyblock = 'PythonPackage'

name = 'python-build-bundle'
version = '2026b'

homepage = 'http://python.org/'
description = """Bundle which contains Python packages useful for building"""
toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

multi_deps = {
    'Python': ['3.14']
}
multi_deps_load_default = False

sources = ['requirements-%(version)s.txt']
checksums = ['5c509a63cd5779f68b2368f479227b6e906d91de6f69a581ddea7f2d17500be5']

# wheels must be available from the wheelhouse
installopts = '--no-index '

unpack_sources = False
use_pip = True
use_pip_for_deps = True
use_pip_requirement = True
fix_python_shebang_for = ['bin/*']
sanity_pip_check = True

exts_filter = ('python -c "import setuptools"', "") # just one of many

sanity_check_paths = {'files': [], 'dirs': ['lib/python%(pyshortver)s/site-packages']}

moduleclass = 'lang'
