easyblock = 'CMakeNinja'
modaltsoftname = 'qt'

name = 'Qt6'
version = '6.12.0'

homepage = 'https://qt.io/'
description = "Qt is a comprehensive cross-platform C++ application framework."

toolchain = {'name': 'GCCcore', 'version': '15.3.0'}

source_urls = [
    'https://download.qt.io/official_releases/qt/%(version_major_minor)s/%(version)s/single/',
    'https://download.qt.io/archive/qt/%(version_major_minor)s/%(version)s/single/',
    'https://download.qt.io/new_archive/qt/%(version_major_minor)s/%(version)s/single/',
    'https://download.qt.io/official_releases/QtForPython/pyside6/PySide6-%(version)s-src/',
]
sources = ['qt-everywhere-src-%(version)s.tar.xz']
patches = ['Qt6-6.7.2_fix_cpu_features.patch']

builddependencies = [
    ('binutils', '2.46.1'),
    ('pkgconf', '2.5.1'),
    ('CMake', '4.4.2'),
    ('Ninja', '1.13.2'),
    ('LLVM', '22.1.8'), # PySide6
]

dependencies = [
    ('double-conversion', '3.4.0'),
    ('GLib', '2.89.0'),
    ('PCRE2', '10.47'),
    ('libpng', '1.6.56'),
    ('LibTIFF', '4.7.1'),
    ('libwebp', '1.6.0'),
    ('JasPer', '4.2.9'),
    ('HarfBuzz', '14.2.0'),
    ('SQLite', '3.51.1'),
    ('graphite2', '1.3.15'),
    ('assimp', '6.0.5'),  # for Qt 3D
    ('X11', '20260518'),
    ('Wayland', '1.25.0'),
    ('Vulkan', '1.4.352'),
    ('fontconfig', '2.17.1'),
    ('zlib', '2.3.3'),
    ('DBus', '1.16.2'),
    ('OpenGL', '9.0.3'),
    ('OpenSSL', '3', '', SYSTEM),
    ('libdrm', '2.4.133'),
    ('GTK3', '3.24.52'),
    ('libiconv', '1.18'),
]
multi_deps = {'Python': ['3.14', '3.15']}
multi_deps_extensions_only = True

exts_defaultclass = 'PythonPackage'  

exts_default_options = {
    'source_urls': [PYPI_SOURCE, 'https://www.riverbankcomputing.com/pypi/packages/%(namelower)s/'],
}

exts_list = [
    ('SIP', '6.17.0', {
        'sources': [SOURCELOWER_PY3_WHL], #SOURCELOWER_TAR_GZ],
        'modulename': 'PyQt6.sip',
    }),
    ('PyQt_builder', '1.20.0', {
	'modulename': 'pyqtbuild',
	'sources': [SOURCELOWER_TAR_GZ],
    }),
    ('PyQt6_sip', '13.13.0', {
        'modulename': 'PyQt6.sip',
        'sources': ['%(namelower)s-%(version)s.tar.gz'],
    }),
    ('PyQt6', '6.12.0', {
        'modulename': 'PyQt6.QtCore',
        'sources': ['%(namelower)s-%(version)s.tar.gz'],
        'preinstallopts': 'sed -i "s/not self.confirm_license:/False:/" project.py && LIBRARY_PATH=$EBROOTGENTOO/lib64/pulseaudio:$LIBRARY_PATH ',
    }),
    ('PySide6', '6.12.0', {
    	'sources': ['pyside-setup-everywhere-src-%(version)s.tar.xz'],
    	'modulename': 'PySide6.QtCore',
	'preinstallopts': 'python setup.py bdist_wheel --parallel=%(parallel)s && ',
	'install_src': ('dist/*.whl && '
                        'rm dist/*.whl && '
                        'setrpaths.sh --path %(installdir)s/lib/python%(pyshortver)s/site-packages/PySide6 --add_path=%(installdir)s/lib/python%(pyshortver)s/site-packages/shiboken6 --any_interpreter && '
                        'setrpaths.sh --path %(installdir)s/lib/python%(pyshortver)s/site-packages/shiboken6_generator/shiboken6 --add_path=$EBROOTLLVM/lib --any_interpreter'),
    }),
]
exts_filter = ("python -c 'import %(ext_name)s'", '')

modextrapaths = {
    'EBPYTHONPREFIXES': [''],
}

# Ninja uses all visible cores by default, which can lead to lack of sufficient memory;
# so $NINJAFLAGS is set to control number of parallel processes used by Ninja;
# note that $NINJAFLAGS is not a generic thing for Ninja, it's very specific to the Qt6 build procedure
preconfigopts = ' export NINJAFLAGS="-j%(parallel)s" && '
prebuildopts = ' export NINJAFLAGS="-j%(parallel)s" && '

configopts = "-Wno-dev -DFEATURE_qtpdf_build=OFF -DQT_AVOID_CMAKE_ARCHIVING_API=ON "
configopts += "-DPython3_ROOT_DIR=$EBROOTPYTHON "
configopts += '-DBUILD_qtwayland=ON ' 

# explicitly disable sysroot as it causes problems for some third party libraries
# (and seems to work without it using rpath wrappers)
configopts += "-DCMAKE_SYSROOT='' "

postinstallcmds = ["setrpaths.sh --path %(installdir)s/plugins/platforms --add_path='$ORIGIN/../../lib'"]

# Dummy bindings for PyQt6-Qt6
local_dist_names = {'pyqt6_qt6': 'PyQt6-Qt6'}

# This step does not iterate as sanity_check does.
postinstallcmds += [
    local_cmd.format(py=local_py)
    for local_py in multi_deps["Python"]
    for local_cmd in
        ["mkdir -p %(installdir)s/lib/python{py}/site-packages/{dist}-%(version)s.dist-info && echo -e 'Metadata-Version: 2.3\nName: {name}\nVersion: %(version)s' > %(installdir)s/lib/python{py}/site-packages/{dist}-%(version)s.dist-info/METADATA".format(py='{py}', dist=dist, name=local_dist_names[dist])
         for dist in local_dist_names]
]

sanity_check_paths = {
    'files': ['bin/qmake6', 'lib/libQt6Core.%s' % SHLIB_EXT],
    'dirs': ['include/QtCore'],
}

sanity_check_commands = ['qmake6 --help']

moduleclass = 'devel'
