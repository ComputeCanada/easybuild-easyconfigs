name = 'MRtrix'
version = '3.0.8'

homepage = 'http://www.brain.org.au/software/index.html#mrtrix'
description = """MRtrix provides a set of tools to perform diffusion-weighted MR white-matter tractography in a manner
 robust to crossing fibres, using constrained spherical deconvolution (CSD) and probabilistic streamlines."""

toolchain = {'name': 'GCC', 'version': '12.3.0'}
toolchainopts = {'cstd': 'c++11'}

source_urls = ['https://github.com/MRtrix3/mrtrix3/archive/refs/tags/']
sources = ['%(version)s.tar.gz']
checksums = ['9c694934781c287c51a0d35ad5d7687b529e5c04e3b2ac0985599b0c48644721']

builddependencies = [
    ('Eigen', '3.4.0', '', SYSTEM),
    ('pkg-config', '0.29.2'),
]

dependencies = [
    ('zlib', '1.2.12'),
    ('Python', '3.10', '', SYSTEM),
    ('Mesa', '22.2.4'),
    ('Qt5', '5.15.11', '', ('GCCcore', '12.3.0')),
    ('LibTIFF', '4.4.0'),
    ('FFTW', '3.3.10'),
    ('libpng', '1.6.38'),
]

moduleclass = 'bio'
