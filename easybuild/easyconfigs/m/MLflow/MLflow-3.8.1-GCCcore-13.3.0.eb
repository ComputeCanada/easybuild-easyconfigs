easyblock = 'Binary'

name = 'MLflow'
version = '3.8.1'

homepage = 'https://mlflow.org/'

description = """MLflow is an open-source developer platform to build AI/LLM applications and models 
with confidence. Enhance your AI applications with end-to-end experiment tracking, observability, 
and evaluations, all in one integrated platform.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

# this is a bundle of Python packages
exts_defaultclass = 'PythonPackage'

builddependencies = [
  ('Arrow', '21.0.0'),
  ('Python', '3.11'),
]

preinstallopts = ['python -m venv %(installdir)s && source %(installdir)s/bin/activate && ']
install_cmd = 'pip install'
installopts = '--no-index --no-deps -r requirements-%(version)s.txt'
sources = ['requirements-%(version)s.txt']

postinstallcmds = [
  "echo '#!/bin/sh' >> %(installdir)s/bin/mlflow-server",
  "echo export EBPYTHONPREFIXES=/cvmfs/soft.computecanada.ca/easybuild/software/2023/x86-64-v3/Compiler/gcccore/arrow/21.0.0:/cvmfs/soft.computecanada.ca/easybuild/software/2023/x86-64-v3/Compiler/gcccore/scipy-stack/2025a:%(installdir)s >> %(installdir)s/bin/mlflow-server",
  'echo exec %(installdir)s/bin/mlflow server \${1+\\"\$@\\"} >> %(installdir)s/bin/mlflow-server',
  "chmod +x %(installdir)s/bin/mlflow-server"
]

sanity_check_paths = {
    'files': ['bin/mlflow'],
    'dirs': ['lib'],
}
moduleclass = 'lib'
modluafooter = """
depends_on("python")
"""

