easyblock = 'CMakeMake'

name = 'DIAMOND'
version = '2.2.8'

homepage = 'https://github.com/bbuchfink/diamond'
description = "Accelerated BLAST compatible local sequence aligner"

toolchain = {'name': 'GCCcore', 'version': '15.3.0'}

github_account = 'bbuchfink'
source_urls = [GITHUB_LOWER_SOURCE]
sources = ['v%(version)s.tar.gz']
checksums = ['a9cc37bd955fa7ed25447278a0b4f97e7036a9abd64f60e6565a56c28219c54c']

builddependencies = [
    ('CMake', '3.29.3'),
]

dependencies = [
    ('zlib', '1.3.1'),
    #('SQLite', '3.45.3'),
]

sanity_check_paths = {
    'files': ['bin/%(namelower)s'],
    'dirs': [],
}
sanity_check_commands = ["%(namelower)s help"]

moduleclass = 'bio'
