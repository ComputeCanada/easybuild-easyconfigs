name = 'GROMACS'
version = '2026.1'

homepage = 'http://www.gromacs.org'
description = """
GROMACS is a versatile package to perform molecular dynamics,
 i.e. simulate the Newtonian equations of motion for systems with hundreds to millions of particles.

This is a CPU only build, containing both MPI and threadMPI builds.
"""

toolchain = {'name': 'gofb', 'version': '2023a'}
toolchainopts = {'openmp': True, 'usempi': True, 'precise': True}

source_urls = [
    'https://ftp.gromacs.org/pub/gromacs/',
    'ftp://ftp.gromacs.org/pub/gromacs/',
]
sources = [SOURCELOWER_TAR_GZ]
#patches = [
#    'GROMACS-2023.2-disable-generateVelocitiesTest.patch'
#]
# checksums are now on checksums.json

builddependencies = [
    ('CMake', '3.31.0'),
    ('python-build-bundle', '2025b'),
    ('mpi4py', '4.0.3'),
    ('pytest', '8.4.1'),
    ('PLUMED', '2.10.0'),
]
dependencies = [
    ('hwloc', '2.9.1'),
    ('FFTW', '3.3.10'),
]

configopts = ' -DGMX_HWLOC=ON '
configopts += '-DMPIEXEC_PREFLAGS=--oversubscribe ' # avoid "not enough slots available"

# use GROMACS' native PLUMED interface
plumed = 'native'
# don't build gmxapi Python package
python_pkg = False

skipsteps = ['test']

pretestopts = ''.join([
#    'test -d %(builddir)s/venv || virtualenv %(builddir)s/venv ; ',
#    'source %(builddir)s/venv/bin/activate && ',
#    'pip install --no-index networkx && ',
    'unset OMP_NUM_THREADS && ',
    'export OMPI_MCA_rmaps_base_oversubscribe=true && ',
])

modextravars = {
    'GROMACS_ROOT': '%(installdir)s'
}
moduleclass = 'chem'
