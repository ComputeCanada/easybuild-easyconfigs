name = 'GROMACS'
version = '2026.4'

homepage = 'http://www.gromacs.org'
description = """
GROMACS is a versatile package to perform molecular dynamics,
 i.e. simulate the Newtonian equations of motion for systems with hundreds to millions of particles.

This is a CPU only build, containing both MPI and threadMPI builds.
"""

toolchain = {'name': 'foss', 'version': '2026'}
toolchainopts = {'openmp': True, 'usempi': True, 'precise': True}

source_urls = [
    'https://ftp.gromacs.org/pub/gromacs/',
    'ftp://ftp.gromacs.org/pub/gromacs/',
]
sources = [SOURCELOWER_TAR_GZ]
patches = [ ]
# checksums are now on checksums.json

builddependencies = [
    ('CMake', '4.4.2'),
    ('python-build-bundle', '2026b'),
    ('pytest', '9.2.0'),
    ('PLUMED', '2.10.2'),
    # GROMACS easyblock doesn't support multideps:
    ('Python', '3.14'),
]
dependencies = [
    ('mpi4py', '4.1.2'),
    ('hwloc', '2.14.0'),
    ('SciPy-Stack', '2026b','', ('GCCcore', '15.3.0')),
]

plumed = 'native'  # use GROMACS' native PLUMED interface
python_pkg = False # don't build gmxapi Python package

configopts = ' '.join([
    '-DGMX_HWLOC=ON',
    '-DGMX_TEST_TIMEOUT_FACTOR=8', # be forgiving w.r.t. timeouts for GROMACS test suite
    '-DMPIEXEC_PREFLAGS=--oversubscribe', # avoid "not enough slots available"
])

exts_defaultclass = 'PythonPackage'
_gmxapi_source_version = version

exts_list = [
    ('networkx', '3.7', {
        'source_urls': ['https://pypi.python.org/packages/source/n/networkx'],
    }),

    # gmxapi version can be found in python_packaging/gmxapi/src/gmxapi/version.py
    ('gmxapi', '0.5.0a1', {
        'patches': ['GROMACS-2024.1-fix-gmxapi-version.patch'],
        'preinstallopts': 'export CMAKE_ARGS="-Dgmxapi_ROOT=%(installdir)s ' +
                          '-C %(installdir)s/share/cmake/gromacs_mpi/gromacs-hints_mpi.cmake" && ',
        'source_tmpl': 'gromacs-%s.tar.gz' % _gmxapi_source_version,
        'start_dir': 'python_packaging/gmxapi',
    }),
]


# skipsteps = ['test']

pretestopts = ''.join([
    'unset OMP_NUM_THREADS && ',
    'export OMPI_MCA_rmaps_base_oversubscribe=true && ',
])

modextravars = {
    'GROMACS_ROOT': '%(installdir)s'
}
moduleclass = 'chem'
