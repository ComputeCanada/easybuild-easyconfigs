easyblock = 'CMakeMake'

name = 'GLFW'
version = '3.5.1'

homepage = 'https://www.glfw.org'
description = '''GLFW is an Open Source, multi-platform library for OpenGL,
    OpenGL ES and Vulkan development on the desktop'''

toolchain = {'name': 'GCCcore', 'version': '15.3.0'}

source_urls = ['https://github.com/%(namelower)s/%(namelower)s/archive/']
sources = ['%(version)s.tar.gz']

builddependencies = [
    ('CMake', '4.4.2'),
]

# make sure both static and shared libs are built
local_python_versions = ['3.14']
local_configopts = [
    "-DBUILD_SHARED_LIBS=OFF -DGLFW_BUILD_WAYLAND=OFF",
    "-DBUILD_SHARED_LIBS=ON  -DGLFW_BUILD_WAYLAND=OFF",
]
configopts = local_configopts * len(local_python_versions)
multi_deps = {'Python': sorted(local_python_versions * 2)}

exts_defaultclass = 'PythonPackage'
exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'download_dep_fail': True,
    'use_pip': True,
}
exts_list = [
    ('glfw', '2.10.2'),
]

sanity_check_paths = {
    'files': [
        'include/GLFW/glfw3.h',
        'include/GLFW/glfw3native.h',
        'lib/libglfw3.a',
        'lib/libglfw.so',
        'lib/pkgconfig/glfw3.pc',
    ],
    'dirs': [
        'include/GLFW',
        'lib/cmake/glfw3',
        'lib/pkgconfig',
    ],
}

modextrapaths = {
    'EBPYTHONPREFIXES': '',
}

modextravars = {
    'PYGLFW_LIBRARY': '%(installdir)s/lib64/libglfw.so',
}

moduleclass = 'vis'
