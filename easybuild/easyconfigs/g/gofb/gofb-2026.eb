easyblock = "Toolchain"

name = 'gofb'
version = '2026'

homepage = '(none)'
description = """GNU Compiler Collection (GCC) based compiler toolchain with OpenMPI and FlexiBLAS"""

toolchain = SYSTEM

local_comp = ('GCC', '15.3.0')

dependencies = [
    local_comp,
    ('OpenMPI', '5.0.10', '', local_comp),
    ('FlexiBLAS', '3.5.0', '', local_comp),
]

moduleclass = 'toolchain'
