easyblock = "Toolchain"

name = 'gcccorecuda'
version = '2023.2.132'

homepage = '(none)'
description = """GNU Compiler Collection (GCC) based compiler toolchain, along with CUDA toolkit (Core level)."""

toolchain = SYSTEM

# compiler toolchain dependencies
dependencies = [
    ('GCCcore', '12.3', '-gentoo'),
    ('CUDAcore', '13.2.0'),
]

moduleclass = 'toolchain'
