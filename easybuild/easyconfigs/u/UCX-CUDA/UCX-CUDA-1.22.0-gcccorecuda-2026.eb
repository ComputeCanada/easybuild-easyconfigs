easyblock = 'EB_UCX_Plugins'

name = 'UCX-CUDA'
version = '1.22.0'

homepage = 'https://www.openucx.org/'
description = """Unified Communication X
An open-source production grade communication framework for data centric
and high-performance applications

This module adds the UCX CUDA support.
"""

toolchain = {'name': 'gcccorecuda', 'version': '2026'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/openucx/ucx/releases/download/v%(version)s']
sources = [{'filename': 'ucx-%(version)s.tar.gz', 'alt_location': 'UCX'}]
patches = ['%(name)s-1.22.0_link_against_existing_UCX_libs.patch']
checksums = [
    {'ucx-1.22.0.tar.gz': '258941cddd14ca60d38c0d31b9b09ec1052c901086841011a498da8b55a3cb24'},
    {'UCX-CUDA-1.22.0_link_against_existing_UCX_libs.patch':
     '93a7e54dda4478481856e6e5372c3488beb9f96de116640c51d7b5bca46d8314'},
]

builddependencies = [
    ('binutils', '2.45'),
    ('Autotools', '20250626'),
    ('pkgconf', '2.5.1'),
]

dependencies = [
    ('zlib', '2.3.2'),
    ('UCX', version),
    ('GDRCopy', '2.6'),
]

# CUDA_CFLAGS set by EB toolchain but also used differently in UCX makefiles
preconfigopts = 'unset CUDA_CFLAGS && '

moduleclass = 'lib'
