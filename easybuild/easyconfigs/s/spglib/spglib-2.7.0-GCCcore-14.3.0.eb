easyblock = 'CMakeMake'

name = 'spglib'
version = '2.7.0'

homepage = 'https://github.com/spglib/spglib'
description = """Spglib is a C library for finding and handling crystal symmetries."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}
toolchainopts = {'openmp': True}

source_urls = [homepage + '/archive']
sources = ['v' + version + '.tar.gz']
checksums = ['b22fc9abae9716c574fbc6d55cfc53ed654a714fccc5657a26ff5d18114bd8bd']

builddependencies = [
    ('CMake', '3.31.0')
]

configopts = [
    "-DSPGLIB_USE_OMP=ON -DSPGLIB_SHARED_LIBS=ON",
    "-DSPGLIB_USE_OMP=ON -DSPGLIB_SHARED_LIBS=OFF",
]

sanity_check_paths = {
    'files': ['lib/libsymspg.a', 'lib/libsymspg.%s' % SHLIB_EXT,
    	     'include/spglib.h'],
    'dirs': [],
}

moduleclass = 'phys'
