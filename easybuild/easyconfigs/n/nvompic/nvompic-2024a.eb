easyblock = 'Toolchain'

name = 'nvompic'
version = '2024a'

homepage = '(none)'
description = """NVHPC Compiler including OpenMPI for MPI support and CUDA."""

toolchain = SYSTEM

local_nvhpcver = '25.1'

builddependencies = [
    ('nvhpccuda', version),
]

# compiler toolchain dependencies
dependencies = [
    ('NVHPC', local_nvhpcver),
    ('OpenMPI', '5.0.3', '', ('NVHPC', local_nvhpcver)),
    ('CUDA', '12.6', '', ('nvompi', version)),
]

moduleclass = 'toolchain'
