name = 'netCDF'
version = '4.9.3'

homepage = 'https://www.unidata.ucar.edu/software/netcdf/'
description = """NetCDF (network Common Data Form) is a set of software libraries
 and machine-independent data formats that support the creation, access, and sharing of array-oriented
 scientific data."""

toolchain = {'name': 'gompi', 'version': '2024a'}
toolchainopts = {'pic': True, 'usempi': True}

source_urls = ['https://github.com/Unidata/netcdf-c/archive/']
sources = ['v%(version)s.tar.gz']
checksums = [
    {'v4.9.3.tar.gz': '990f46d49525d6ab5dc4249f8684c6deeaf54de6fec63a187e9fb382cc0ffdff'},
]

builddependencies = [
    ('Autotools', '20220317'),
    ('CMake', '3.26.3'),
    ('Doxygen', '1.9.7'),
    ('numpy', '2.1.1'),
    ('Cython', '3.0.11'),
    ('mpi4py', '4.0.0'),
    # ('python-build-bundle', '2025a'),
]

dependencies = [
    ('HDF5', '1.14.5'),
    ('cURL', '8.0.1'),
    ('Szip', '2.1.1'),
    ('zstd', '1.5.5'),
    ('bzip2', '1.0.8'),
    ('libxml2', '2.11.4'),
]

local_python_versions = ['3.10', '3.11', '3.12', '3.13']
# make sure both static and shared libs are built
local_configopts = [
    "-DBUILD_SHARED_LIBS=OFF",
    "-DBUILD_SHARED_LIBS=ON",
]
configopts = local_configopts * len(local_python_versions)
multi_deps = {'Python': local_python_versions * 2}

exts_defaultclass = 'PythonPackage'
exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'download_dep_fail': True,
    'use_pip': True,
    'preinstallopts': "PYTHONPATH=%(installdir)s/lib/python%(pyshortver)s/site-packages:$PYTHONPATH",
    'sanity_pip_check': False,   # disable "pip check"
}
exts_list = [
    ('certifi', '2025.4.26'),
    ('cftime', '1.6.4.post1'),
    ('netCDF4', '1.7.2', {
        'sources': {'filename': 'netcdf4-1.7.2.tar.gz'},
        'fix_python_shebang_for': ['bin/*']
    }),
]

exts_filter = ("module load mpi4py/4.0.0 numpy/.2.1.1; python -c 'import netCDF4'", '')

modextrapaths = {'EBPYTHONPREFIXES': ''}

moduleclass = 'data'
