name = 'NCL'
version = '6.6.2'

homepage = 'https://www.ncl.ucar.edu'
description = "NCL is an interpreted language designed specifically for scientific data analysis and visualization."

toolchain = {'name': 'gofb', 'version': '2026'}
toolchainopts = {
    'cstd': 'c99', 'openmp': True, 'pic': True,
    'extra_cflags': (
        '-Wno-error=implicit-int -Wno-error=implicit-function-declaration '
        '-Wno-error=incompatible-pointer-types -Wno-error=int-conversion '
        '-Wno-error=return-mismatch'
    ),
    # as suggested in https://github.com/NCAR/ncl/issues/123#issuecomment-650691723 
    # add flags to ignore errors of newer gfortran compilers.
    'extra_fflags': '-fallow-invalid-boz -fallow-argument-mismatch',
}

source_urls = ['https://github.com/NCAR/ncl/archive/']
sources = ['%(version)s.tar.gz']
patches = [
    'NCL-6.4.0_fix-types.patch',
    'NCL-6.6.2_header_and_operands.patch',
    'NCL-6.6.2_multiple_definitions.patch',
    'NCL-6.6.2_search_Gentoo_prefix.patch',
    'NCL-6.6.2_use_HDF5v110_API.patch',
    'NCL-6.6.2_link_libaec_g2c.patch',
    'NCL-6.6.2_gentoo-lib-cpp.patch',
    'NCL-6.6.2_fix-missing-Copyright.patch',
    'NCL-6.6.2_fix-NetCDF4-log-level.patch',
    'NCL-6.6.2_PROJ-compatibility.patch',
    'NCL-6.6.2_hdf5-fix.patch',
    'NCL-6.6.2_fix-tcsh-invocation.patch',
    'NCL-6.6.2_ymake-filter-prototypes.patch',
]
checksums = [
    {'6.6.2.tar.gz': 'cad4ee47fbb744269146e64298f9efa206bc03e7b86671e9729d8986bb4bc30e'},
    {'NCL-6.4.0_fix-types.patch': 'f6dfaf95e5de9045745e122cb44f9c035f81fab92f5892991ddfe93945891c8f'},
    {'NCL-6.6.2_header_and_operands.patch': '5cb62d9a37de8af485b94487692f7e739ca5eb103a6b447e0290a68a6c094808'},
    {'NCL-6.6.2_multiple_definitions.patch': 'e21503dc46fe6fd360ba7ca4897aa93bf9ec2961bc48634ca46de582710448f7'},
    {'NCL-6.6.2_search_Gentoo_prefix.patch': '036b948f6a7fe6e3250775b8fe22414b7d5c3ca438728f548ca07d8bc8332e2d'},
    {'NCL-6.6.2_use_HDF5v110_API.patch': 'd97b48f5fefbc55c6eed9416dfeed910d9070a4478118d0e1abcdd775fcb0a70'},
    {'NCL-6.6.2_link_libaec_g2c.patch': '5b09f70841cfd41a1a2f1f154dae2cca5b1ea82f2a71b9f5846a79f9ebe69234'},
    {'NCL-6.6.2_gentoo-lib-cpp.patch': '988ed5f7f6d63b3a3eefc0483359eeb4d6c6d1bbbcbf5d2d2028886a5d2f17be'},
    {'NCL-6.6.2_fix-missing-Copyright.patch': 'e125f3af1a9a78388127215078538551b52153e564e2d316f815c6debf257248'},
    {'NCL-6.6.2_fix-NetCDF4-log-level.patch': '6bfbfcc9898730f66b6a22f44112a210aef72ba091af4fa222675cd8d1af8e8a'},
    {'NCL-6.6.2_PROJ-compatibility.patch': '5ce206e5b9edab082a8e192f081faa82e4812ca2ba5ff065b72624be04bb5b83'},
    {'NCL-6.6.2_hdf5-fix.patch': '63fcfb938a345edd5b23cf1e0b026fc095394d63a5818a194b52df9abeaddb69'},
    {'NCL-6.6.2_fix-tcsh-invocation.patch': '7f4c6083419720f6cbefb32f1dbe3196ca91dede8b37c99d646805ebf56adda4'},
    {'NCL-6.6.2_ymake-filter-prototypes.patch': '6175b0d862ec485df319ba28441517633a163fe1de27ddcfc8bd1e70bf12049c'},
]

preinstallopts = "CPATH=$EBROOTGENTOO/include/freetype2:$CPATH GENTOO_GCC_INCLUDE=${EBROOTGENTOO}/lib/gcc/x86_64-pc-linux-gnu/15/include "

builddependencies = [
    ('makedepend', '1.0.9'),
    ('Bison', '3.8.2'),
    ('flex', '2.6.4'),
]
dependencies = [
    ('cURL', '8.14.1'),
    ('JasPer', '4.2.9'),
    ('g2lib', '4.0.0'),
    ('g2clib', '2.3.0'),
    ('HDF5', '2.2.0'),
    ('HDF', '4.4.0'),
    ('netCDF', '4.10.1'),
    ('netCDF-Fortran', '4.6.2'),
    ('Szip', '2.1.1'),
    ('freetype', '2.13.3'),
    ('zlib', '1.3.1'),
    ('GDAL', '3.13.3'),
    ('UDUNITS', '2.2.28'),
    ('ESMF', '8.9.1'),
    ('bzip2', '1.0.8'),
    ('cairo', '1.18.4'),
    ('libiconv', '1.18'),
    ('GSL', '2.8'),
    ('libpng', '1.6.50'),
    ('libjpeg-turbo', '3.1.1'),
    ('tcsh', '6.24.16'),
]

moduleclass = 'data'
