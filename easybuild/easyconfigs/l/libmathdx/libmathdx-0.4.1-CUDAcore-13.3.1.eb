easyblock = 'Tarball'

name = 'libmathdx'
version = '0.4.1'

homepage = 'https://developer.nvidia.com/cublasdx-downloads'
description = """libmathdx is a library used to integrate cuBLASDx and cuFFTDx into Warp"""

toolchain = {'name': 'CUDAcore', 'version': '13.3.1'}
toolchainopts = {'optarch': 'False'}
local_cuda_major = toolchain['version'].split('.')[0] # major

sources = [f'%(namelower)s-Linux-x86_64-%(version)s-cuda{local_cuda_major}.0.tar.gz']
checksums = ['7ce0b2b58dd34f42d2da631c14d97f633be97287a748cab57b055d611823074d']

sanity_check_paths = {
    'files': [
        "lib/libmathdx.so",
        "lib/libmathdx_static.a",
        "include/libcommondx.h",
        "include/libcublasdx.h",
        "include/libcufftdx.h",
        "include/libcuranddx.h",
        "include/libcusolverdx.h",
        "include/libmathdx.h",
    ],
    'dirs': ['include', 'lib'],
}

accept_eula = True

moduleclass = 'numlib'
