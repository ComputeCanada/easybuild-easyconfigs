name = 'LS-DYNA'
version = '14.2.0'
easyblock = "Binary"
modaltsoftname = 'ls-dyna-mpi'
local_lsdyna_mpp_s = 'ls-dyna_mpp_s_R14_2_0_x64_centos79_ifort190_avx512_openmpi405_sharelib'
local_lsdyna_mpp_d = 'ls-dyna_mpp_d_R14_2_0_x64_centos79_ifort190_avx512_openmpi405_sharelib'

homepage = 'http://www.lstc.com/products/ls-dyna'
description = """LS-DYNA is a general-purpose finite element program capable of simulating complex real world problems. 
It is used by the automobile, aerospace, construction, military, manufacturing, and bioengineering industries. 
LS-DYNA is optimized for shared and distributed memory Unix, Linux, and Windows based, platforms, and it is fully 
QA'd by LSTC. The code's origins lie in highly nonlinear, transient dynamic finite element analysis using explicit 
time integration.
"""

# module load StdEnv/2023
toolchain = {'name': 'iompi', 'version': '2025b'}

# download sources from ftp.lstc.com
sources = [
      f'{local_lsdyna_mpp_s}.tgz',
      f'{local_lsdyna_mpp_d}.tgz'
]

# sha256sum 
checksums = [
      '1e2446779ba154063f5801e152c1ba329cf804c671f9f77253adf72cb163554a',
      '2f37383af5d8ae1ae45d6fa6824c8f60d134a6cf17278c6b7ef6bf31f1fcff9f'
]

extract_sources = True

install_cmd = "rsync -av %(builddir)s/* %(installdir)s/"

postinstallcmds = [
#     f'gzip -k %(installdir)s/{local_lsdyna_mpp_s}/{local_lsdyna_mpp_s}',
#     f'gzip -k %(installdir)s/{local_lsdyna_mpp_d}/{local_lsdyna_mpp_d}',
      f'ln -s {local_lsdyna_mpp_s} %(installdir)s/{local_lsdyna_mpp_s}/ls-dyna_s',
      f'ln -s {local_lsdyna_mpp_d} %(installdir)s/{local_lsdyna_mpp_d}/ls-dyna_d',
      f'chmod +x %(installdir)s/{local_lsdyna_mpp_s}/{local_lsdyna_mpp_s}',
      f'chmod +x %(installdir)s/{local_lsdyna_mpp_d}/{local_lsdyna_mpp_d}',
      f'/cvmfs/soft.computecanada.ca/gentoo/2023/x86-64-v3/usr/bin/patchelf --set-rpath "" %(installdir)s/{local_lsdyna_mpp_s}/ls-dyna_s',
      f'/cvmfs/soft.computecanada.ca/gentoo/2023/x86-64-v3/usr/bin/patchelf --set-rpath "" %(installdir)s/{local_lsdyna_mpp_d}/ls-dyna_d',
      f'/cvmfs/soft.computecanada.ca/easybuild/bin/setrpaths.sh --path %(installdir)s --add_origin --add_path $EBROOTOPENMPI/lib --verbose',
      f'patchelf --print-rpath %(installdir)s/{local_lsdyna_mpp_s}/ls-dyna_s',
      f'patchelf --print-rpath %(installdir)s/{local_lsdyna_mpp_d}/ls-dyna_d',
      f'patchelf --print-interpreter %(installdir)s/{local_lsdyna_mpp_s}/ls-dyna_s',
      f'patchelf --print-interpreter %(installdir)s/{local_lsdyna_mpp_d}/ls-dyna_d'
]

modextrapaths = {'PATH': [f'{local_lsdyna_mpp_s}',f'{local_lsdyna_mpp_d}']}

sanity_check_paths = {
    'files': [f"{local_lsdyna_mpp_s}/ls-dyna_s", f"{local_lsdyna_mpp_s}/ansyscl",
              f"{local_lsdyna_mpp_d}/ls-dyna_d", f"{local_lsdyna_mpp_d}/ansyscl"],
    'dirs': []
}

modluafooter = """
require("SitePackage")
local found = find_and_define_license_file("LSTC_FILE","ls-dyna")
if (not found) then
        local error_message = [[
	We did not find a suitable license for LS-DYNA. If you have access to one, you can create the file $HOME/.licenses/ls-dyna.lic with the license information. If you think you should have access to one as part of your institution, please write to support@tech.alliancecan.ca so that we can configure it.

	Nous n'avons pas trouve de licence utilisable pour LS-DYNA. Si vous avez acces a une licence de LS-DYNA, vous pouvez creer le fichier $HOME/.licenses/ls-dyna.lic avec l'information de la licence. Si vous pensez que vous devriez automatiquement avoir acces a une licence via votre institution, veuillez ecrire a support@tech.alliancecan.ca pour que nous puissions la configurer.
	]]
	LmodError(error_message)
end
"""
