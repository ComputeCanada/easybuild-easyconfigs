easyblock = 'ConfigureMake'

name = 'LibreQDA'
version = '1.2.1'

homepage = 'https://gitlab.com/bin-cirst/libreqda/libre-qda'
description = """LibreQDA is an open-source web-based document tagging tool for qualitative data analysis.

Using this tool, you can upload a collection of documents, create a hierarchy of codes, and annotate portions of documents with codes and notes that you can recall and organize later."""

toolchain = SYSTEM
source_urls = ['https://gitlab.com/bin-cirst/libreqda/libre-qda/-/archive/%(name_lower)s-v%(version)s']
sources = ['libre-qda-libreqda-v%(version)s.tar.gz']
checksums = ['763d99fad1e1f8c99903cc49d493ffc02b40ae1569b75eb0e042d102e1c2c249']

#patches = ['libreqda-%(version)s-alliancecan.patch']

dependencies = [('calibre', '8.6.0')]
builddependencies = [('Python', '3.13'), ('python-build-bundle','2026a'), ('babel', '2.17.0')]

skipsteps = ['configure', 'build']
preinstallopts = 'scripts/update_translations.sh && rm %(builddir)s/libre-qda-libreqda-v%(version)s/poetry.lock && '
preinstallopts += 'poetry --verbose -vvv lock && '
install_cmd = 'poetry --verbose -vvv bundle venv'
installopts = '%(installdir)s/bundle'
postinstallcmds = ['mkdir %(installdir)s/bin; ln -s %(installdir)s/bundle/bin/libreqda %(installdir)s/bin/libreqda; ln -s %(installdir)s/bundle/bin/libreqda %(installdir)s/bin/taguette']

local_language_map = {'fr': 'fr_FR', 'fr_CA': 'fr_FR', 'en': 'en_US', 'en_CA': 'en_US', 'en_UK': 'en_US'}
postinstallcmds += ['ln -s %s %%(installdir)s/bundle/lib/python%%(pyshortver)s/site-packages/taguette/l10n/%s' % (src, dst) for dst, src in local_language_map.items()]
postinstallcmds += ['module load libreqda/%(version)s; /cvmfs/soft.computecanada.ca/easybuild/easybuild-computecanada-config/generate_cvmfs_filebundle.py --executable %(installdir)s/bin/taguette --args "--no-browser --base_path /user/ebuser/libreqda --unix_socket /tmp/jupyter-server-proxy-26n1zk0n/socket --debug" --prefix /cvmfs/soft.computecanada.ca']

sanity_check_paths = {
    'files': ['bundle/bin/libreqda', 'bin/libreqda', 'bin/taguette'],
    'dirs': ['bundle/lib']
}

moduleclass = 'data'
