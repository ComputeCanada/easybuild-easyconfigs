easyblock = 'CMakeMake'

name = 'libspatialindex'
version = '2.1.0'

homepage = 'https://libspatialindex.org'
description = """C++ implementation of R*-tree, an MVR-tree and a TPR-tree with C API"""

toolchain = {'name': 'GCCcore', 'version': '12.3.0'}

source_urls = ['https://github.com/libspatialindex/libspatialindex/releases/download/%(version)s/']
sources = ['spatialindex-src-%(version)s.tar.gz']
checksums = ['b36e2f8ac4c91a6d292f11d5925d584e13674015afd2132ed2870f1b5ec7b9ad']

builddependencies = [
    ('binutils', '2.39'),
    ('CMake', '3.31.0'),
]

sanity_check_paths = {
    'files': ['lib/libspatialindex.%s' % SHLIB_EXT],
    'dirs': ['include/spatialindex'],
}

modextravars = {
    'SPATIALINDEX_C_LIBRARY': '%(installdir)s' + '/lib/libspatialindex.%s'% SHLIB_EXT,
}

moduleclass = 'lib'
