easyblock = 'ConfigureMake'

name = 'VCFtools'
version = '0.1.17'

homepage = 'https://vcftools.github.io'
description = """The aim of VCFtools is to provide 
 easily accessible methods for working with complex 
 genetic variation data in the form of VCF files."""

toolchain = {'name': 'GCCcore', 'version': '15.3.0'}

source_urls = ['https://github.com/%(namelower)s/%(namelower)s/releases/download/v%(version)s/']
sources = [SOURCELOWER_TAR_GZ]
checksums = ['b9e0e1c3e86533178edb35e02c6c4de9764324ea0973bebfbb747018c2d2a42c']

dependencies = [
    ('Perl', '5.44.0'),
    ('HTSlib', '1.24'),
    ('zlib', '1.2.11'),
]

sanity_check_paths = {
    'files': ['bin/%(namelower)s', 'bin/vcf-sort', 'bin/vcf-stats'],
    'dirs': [],
}

modextrapaths = {'PERL5LIB': 'lib/perl5/site_perl'}

moduleclass = 'bio'
