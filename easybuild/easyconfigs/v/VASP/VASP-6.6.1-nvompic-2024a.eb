easyblock = 'MakeCp'

name = 'VASP'
version = '6.6.1'

homepage = 'http://www.vasp.at'
description = """The Vienna Ab initio Simulation Package (VASP) is a computer program for atomic scale
materials modelling, e.g. electronic structure calculations and quantum-mechanical molecular dynamics,
based on Density Futional Theory (DFT)."""

toolchain = {'name': 'nvompic', 'version': '2024a'}
local_binfiles = ['vasp_std', 'vasp_gam', 'vasp_ncl']

builddependencies = [
    ('HDF5', '1.14.5','', ('NVHPC', '25.1')),
    ('FlexiBLAS', '3.4.4','', ('NVHPC', '25.1')),
    ('FFTW', '3.3.10','', ('NVHPC', '25.1')),
    ('ScaLAPACK', '2.2.0','-fb', ('nvompi', '2024a')),
]

sources = ['%(namelower)s.%(version)s.tgz']
patches = ['%(namelower)s-%(version)s-nvompic.patch']
checksums = [
    {'vasp.6.6.1.tgz': '261f9c1fd730468106191afeb185821d67cb7a58c982f6e063824dd5432106b0'},
    {'vasp-6.6.1-nvompic.patch': '20f8a18503f1796abbd48cee5cb467fed50aa454116750ab73487612105f0b22'},
]

# Vasp is proprietary software, see http://www.vasp.at/index.php/faqs on how to get access to the code
prebuildopts = 'cp arch/makefile.include.nvhpc_acc ./makefile.include && cp src/paw.F src/pawn.F && '
prebuildopts += 'unset LIBS && '
#prebuildopts += 'export LIBRARY_PATH=$LIBRARY_PATH:${EBROOTNVHPC}/Linux_x86_64/${EBVERSIONNVHPC}/comm_libs/12.6/hpcx/hpcx-2.20/ompi/lib/ && '

import os
if os.getenv('RSNT_ARCH') == 'avx512':
  local_vasp_target_cpu ='"-tp=skylake-avx512"'
elif os.getenv('RSNT_ARCH') == 'avx2':
  local_vasp_target_cpu ='"-tp=px"'

prebuildopts += 'unset LIBS && '
build_cmd = 'make VASP_TARGET_CPU=%s' % local_vasp_target_cpu

postinstallcmds = ["chmod -R o-rwx %(installdir)s && ln -f -s /opt/software/easybuild/2017/avx2/MPI/intel2016.4/openmpi2.1/vasp/pseudopotentials %(installdir)s/pseudopotentials"]
parallel = 1

files_to_copy = [(['bin/%s' % x for x in local_binfiles], 'bin')]
sanity_check_paths = {
    'files': ['bin/%s' % x for x in local_binfiles],
    'dirs': []
}
moduleclass = 'phys'

