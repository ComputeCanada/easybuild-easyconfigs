easyblock = 'MakeCp'

name = 'Verkko'
version = '2.3'

homepage = 'https://github.com/marbl/verkko'
description = """Telomere-to-telomere assembly of accurate long reads (PacBio HiFi, Oxford Nanopore Duplex,
HERRO corrected Oxford Nanopore Simplex) and Oxford Nanopore ultra-long reads."""

toolchain = {'name': 'GCC', 'version': '12.3.0'}

source_urls = ['https://github.com/marbl/%(namelower)s/releases/download/v%(version)s/']
sources = [
  {'download_filename': '%(namelower)s-v%(version)s.tar.gz', 'filename': SOURCE_TAR_GZ}, 
]
checksums = [
    {'Verkko-2.3.tar.gz': '2d436c064f745cb07a46dca8e72cb1906b793d059b31ce875454ff85fcc6770d'},
]

builddependencies = [
    ('Rust', '1.91.0'),
]
dependencies = [
    ('Python', '3.11'),
    ('parasail', '2.6.2'),
    ('MashMap', '3.1.3'),
    ('GraphAligner', '1.0.20'),
    ('Winnowmap', '2.03'),
    ('BWA', '0.7.18'),
    ('minimap2', '2.28'),
    ('SAMtools', '1.22.1'),
    ('seqtk', '1.4'),
]
# do not use start_dir = 'src' - /lib and /bin are not created there + rm run_test broken link
prebuildopts = ' && '.join([
  'cd src',
  ''
])
postinstallcmds = [
  'python -m venv %(installdir)s/venv',
  'source %(installdir)s/venv/bin/activate',
  'pip install --upgrade --no-index pip',
  'pip install --no-index biopython==1.83 cluster==1.4.1.post2 line_profiler==4.1.2 memory_profiler==0.61.0 networkx==3.6.1 pysam==0.23.3 snakemake==9.14.6',
]

files_to_copy = ['bin', 'lib']

sanity_check_paths = {
    'files': ['bin/%(namelower)s'],
    'dirs': ['bin', 'lib'],
}

modextrapaths = {
  'PYTHONPATH': 'lib/verkko/scripts',
  'EBPYTHONPREFIXES': 'venv',
}
sanity_check_commands = ['%(namelower)s --help']

moduleclass = 'bio'
